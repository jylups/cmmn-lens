{
  "name": "@jylups/cmmn-lens-server",
  "version": "0.4.1",
  "description": "MCP server for the cmmn-lens plugin: serves an interactive viewer for local CMMN, BPMN and DMN files and form-js forms on localhost.",
  "keywords": [
    "cmmn",
    "flowable",
    "mcp",
    "case-management",
    "viewer"
  ],
  "homepage": "https://github.com/jylups/cmmn-lens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jylups/cmmn-lens.git",
    "directory": "server"
  },
  "bugs": "https://github.com/jylups/cmmn-lens/issues",
  "license": "MIT",
  "author": {
    "name": "jylups",
    "url": "https://github.com/jylups"
  },
  "type": "module",
  "bin": {
    "cmmn-lens-server": "dist/server.mjs"
  },
  "files": [
    "dist",
    "public",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@bpmn-io/dmn-migrate": "0.8.0",
    "@bpmn-io/form-js-editor": "1.26.1",
    "@bpmn-io/form-js-viewer": "1.26.1",
    "@bpmn-io/properties-panel": "3.60.2",
    "@jylups/cmmn-js": "0.26.1",
    "@jylups/cmmn-moddle": "6.1.1",
    "@jylups/flowable-bpmn-js": "0.1.1",
    "@jylups/flowable-bpmn-moddle": "0.1.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bpmn-font": "0.13.0",
    "bpmn-moddle": "10.3.1",
    "cmmn-js-properties-panel-flowable": "3.14.2",
    "dmn-font": "0.6.2",
    "dmn-js": "18.1.0",
    "dmn-js-properties-panel": "3.13.0",
    "dmn-moddle": "12.2.1",
    "esbuild": "0.28.2",
    "flowable-cmmn-moddle": "1.5.0",
    "less": "4.9.1",
    "zod": "^4.6.7"
  }
}
