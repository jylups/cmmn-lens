{
  "name": "@jylups/cmmn-lens-server",
  "version": "0.1.3",
  "description": "MCP server for the cmmn-lens plugin: serves an interactive viewer for local CMMN files on localhost.",
  "keywords": [
    "cmmn",
    "flowable",
    "mcp",
    "case-management",
    "viewer"
  ],
  "homepage": "https://github.com/jylups/cmmn-lens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jylups/cmmn-lens.git",
    "directory": "server"
  },
  "bugs": "https://github.com/jylups/cmmn-lens/issues",
  "license": "MIT",
  "author": {
    "name": "jylups",
    "url": "https://github.com/jylups"
  },
  "type": "module",
  "bin": {
    "cmmn-lens-server": "dist/server.mjs"
  },
  "files": [
    "dist",
    "public",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@jylups/cmmn-js": "0.25.1",
    "@jylups/cmmn-moddle": "6.1.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cmmn-js-properties-panel-flowable": "3.6.0",
    "esbuild": "0.28.2",
    "flowable-cmmn-moddle": "1.5.0",
    "less": "4.9.1",
    "zod": "^4.6.7"
  }
